{
  "name": "innerhealth",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev --webpack --port ${PORT:-3000}",
    "dev:turbopack": "node ./node_modules/next/dist/bin/next dev --turbo --port ${PORT:-3000}",
    "dev:webpack": "node ./node_modules/next/dist/bin/next dev --webpack --port ${PORT:-3000}",
    "build": "next build",
    "build:bot": "node scripts/build-bot.mjs",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "typecheck:compat": "tsc6 --noEmit --incremental false",
    "start": "next start",
    "deploy:check": "npm run lint && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:adaptive": "vitest run src/lib/adaptive-tokens.test.ts src/hooks/use-overlap-detection.test.ts",
    "test:playwright": "npm --prefix .. run test:playwright --",
    "test:playwright:adaptive": "npm --prefix .. run test:playwright -- --grep=adaptive",
    "test:playwright:ui": "npm --prefix .. run test:playwright -- --ui",
    "test:adaptive:check": "node scripts/test-adaptive-enhanced.js",
    "test:adaptive:verbose": "node scripts/test-adaptive-enhanced.js --verbose",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "favicon": "node scripts/generate-favicon.mjs",
    "seed:categories": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/seed-categories.ts",
    "seed:category-line-drafts": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' -r tsconfig-paths/register scripts/seed-category-line-drafts.ts",
    "seed:inner-category-content": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/seed-inner-category-content.ts",
    "create-admin": "ts-node scripts/create-admin-user.ts",
    "add-admin": "ts-node scripts/add-admin-user.ts",
    "import-tilda-leads": "ts-node scripts/import-tilda-leads.ts",
    "manage-users": "ts-node scripts/manage-users.ts",
    "security:hash-legacy-passwords": "ts-node scripts/hash-legacy-passwords.ts",
    "migrate:user-role": "ts-node scripts/migrate-add-user-role.ts",
    "backfill:slug": "ts-node scripts/backfill-product-slug.ts",
    "backfill:sanitize-text": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/backfill-product-text-sanitize.ts",
    "backfill:dimensions": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/backfill-product-dimensions-from-csv.ts",
    "sync:product-photos": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/sync-product-photos-from-tilda.ts",
    "media:migrate-to-storage": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/migrate-local-uploads-to-storage.ts",
    "tilda:download-images": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/download-tildacdn-images-to-local.ts",
    "telegram-bot": "ts-node --transpile-only -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/telegram-bot.ts",
    "max-bot:dev": "ts-node --transpile-only -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/max-bot.ts",
    "redirects:compare": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/compare-sites-redirects.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:fix-history": "ts-node scripts/fix-migration-history.ts",
    "db:mark-applied": "ts-node scripts/mark-migrations-applied.ts",
    "deploy:preflight": "prisma generate && prisma migrate status",
    "start:with-migrate": "prisma migrate deploy && next start",
    "maintenance:cleanup-auth": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/cleanup-auth-tokens.ts",
    "maintenance:anonymize-checkout-sessions": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' scripts/anonymize-old-checkout-sessions.ts",
    "check": "npm run lint && npm run typecheck && npm run typecheck:compat && npm test && npm run build && npm run build:bot",
    "test:smoke": "npm --prefix .. run test:smoke"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/lib-storage": "^3.1090.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@maxhub/max-bot-api": "0.2.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-table-cell": "3.32.0",
    "@tiptap/extension-table-header": "3.32.0",
    "@tiptap/extension-table-row": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "fetch-socks": "^1.3.3",
    "geoip-lite": "^1.4.10",
    "iconoir-react": "^7.11.0",
    "libphonenumber-js": "^1.12.40",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "nodemailer": "^7.0.13",
    "otplib": "^13.3.0",
    "pg": "^8.18.0",
    "postgres-date": "^2.1.0",
    "prisma": "7.10.1",
    "prompts": "^2.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "3.7.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "undici": "^7.22.0",
    "validator": "^13.15.26",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.11",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "autoprefixer": "^10.4.24",
    "esbuild": "^0.28.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.14.0",
    "jsdom": "^28.1.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
